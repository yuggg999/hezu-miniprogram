/* 首页样式 */
.page-index {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background: #4A90D9;
}

.search-input {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-input .icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.search-input .placeholder {
  color: #999;
  font-size: 28rpx;
}

/* 筛选栏 */
.filter-section {
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.filter-tabs {
  display: flex;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-tabs .tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.filter-tabs .tab.active {
  color: #4A90D9;
  font-weight: 600;
}

.filter-tabs .tab .arrow {
  font-size: 20rpx;
  margin-left: 6rpx;
  transition: transform 0.3s;
}

.filter-tabs .tab .arrow.up {
  transform: rotate(180deg);
}

/* 筛选面板 */
.filter-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: #fff;
}

.filter-panel.show {
  max-height: 500rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-group {
  margin-bottom: 20rpx;
}

.filter-group .label {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.filter-group .options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-group .option {
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.filter-group .option.active {
  background: #e8f0fe;
  color: #4A90D9;
}

.filter-actions {
  text-align: center;
  padding-top: 10rpx;
}

.btn-clear {
  color: #999;
  font-size: 26rpx;
}

/* 帖子列表 */
.post-list {
  padding: 20rpx 24rpx;
}

/* 加载状态 */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: #ccc;
  font-size: 24rpx;
}
