/* 筛选栏样式 */
.filter-bar {
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tabs {
  display: flex;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  color: #4A90D9;
  font-weight: 600;
}

.tab .arrow {
  font-size: 20rpx;
  margin-left: 6rpx;
  transition: transform 0.3s;
}

.tab .arrow.up {
  transform: rotate(180deg);
}

.panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.panel.show {
  max-height: 500rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.group {
  margin-bottom: 20rpx;
}

.group .label {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.group .options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option {
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.option.active {
  background: #e8f0fe;
  color: #4A90D9;
}

.actions {
  text-align: center;
  padding-top: 10rpx;
}

.btn-clear {
  color: #999;
  font-size: 26rpx;
}
