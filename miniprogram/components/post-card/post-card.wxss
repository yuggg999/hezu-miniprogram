/* 帖子卡片样式 */
.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.post-card:active {
  transform: scale(0.98);
}

/* 头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.title-row {
  flex: 1;
  margin-right: 16rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.price {
  font-size: 32rpx;
  font-weight: 700;
  color: #e74c3c;
  white-space: nowrap;
}

/* 内容 */
.card-body {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  gap: 6rpx;
}

.source-tag {
  font-weight: 500;
}

.area-tag {
  background: #f0f0f0;
  color: #666;
}

.desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}

.time {
  font-size: 22rpx;
}
